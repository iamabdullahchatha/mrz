# Resend — contact form email delivery (src/app/contact/actions.ts)
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Required: your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional: the "from" address. Must be on a domain you have verified in Resend.
# Leave unset to use Resend's shared onboarding sender while your domain is
# still being verified.
# CONTACT_FROM_EMAIL=MRZ Website <noreply@mrzuae.com>

# Optional: where enquiries are delivered. Defaults to the public inbox
# (info@mrzuae.com) when unset.
# CONTACT_TO_EMAIL=info@mrzuae.com
